# Radius mobile/web client — environment template.
#
# Copy this file to `.env` (same folder), fill in the real values, and pass it
# at run/build time:
#
#   flutter run -d chrome --web-port=3000 --dart-define-from-file=.env
#   flutter run --dart-define-from-file=.env                  # android device
#
# Testing two accounts at once? Use the web-server device instead of chrome:
#   flutter run -d web-server --web-port=3000 --dart-define-from-file=.env
# `-d chrome` attaches a DWDS debug service that expects a single app instance,
# so a second browser window on the same URL fails with "Failed to establish
# connection with the application instance in Chrome". Keep the port at 3000 —
# the backend's CORS_ORIGINS only allows localhost:3000 / localhost:5173.
#   flutter build web --dart-define-from-file=.env
#
# `.env` is gitignored; this template is not. Every key below is REQUIRED —
# the app refuses to boot and names the missing keys if one is blank.
#
# Format notes: `KEY=value`, one per line, no quotes, no `${}` interpolation.

# ───────────────────── Supabase (auth) ─────────────────────
# Must be the SAME project the backend verifies tokens against
# (backend .env → SUPABASE_URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to ship in a client, but not committed here.
# Supabase Dashboard → Project Settings → API → Project API keys → anon public.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.replace-me

# ───────────────────── Radius backend ──────────────────────
# REST base URL — must already include the /api/v1 prefix.
#   cloud            http://65.2.220.189/api/v1
#   android emulator http://10.0.2.2:3000/api/v1
#   web / desktop    http://localhost:3000/api/v1
API_BASE_URL=http://65.2.220.189/api/v1

# Socket.io origin — NO path. The /presence and /chat namespaces are appended
# by the socket services.
#   cloud            http://65.2.220.189
#   android emulator http://10.0.2.2:3000
#   web / desktop    http://localhost:3000
SOCKET_BASE_URL=http://65.2.220.189

# ─────────────────── Explore map (all optional) ───────────────────
# The Explore tab renders MapLibre vector tiles. These three keys have
# defaults, so leaving the whole block out works — the app falls back to
# OpenFreeMap, which serves OpenMapTiles-schema tiles with no key and no
# account. Set them to move to a different provider.
#
# The style asset (assets/map/explore_style.json) addresses source layers by
# name — building, transportation, water, park, landcover, place — so any
# provider on the OpenMapTiles schema drops in without touching the style.
#
# TileJSON URL for the vector source. A literal {key} in the value is replaced
# with MAP_TILES_API_KEY at run time.
#   openfreemap  https://tiles.openfreemap.org/planet          (no key)
#   maptiler     https://api.maptiler.com/tiles/v3/tiles.json?key={key}
#   stadia       https://tiles.stadiamaps.com/data/openmaptiles.json?api_key={key}
# MAP_TILES_URL=https://tiles.openfreemap.org/planet

# Label glyphs. Must keep the {fontstack} and {range} placeholders — MapLibre
# fills those in itself. The style asks for Noto Sans Regular/Bold/Italic.
# MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# Provider token, for providers that need one. NEVER commit a real value —
# pass it at build time instead:
#   flutter build apk --dart-define-from-file=.env --dart-define=MAP_TILES_API_KEY=xxx
# Restrict the key at the provider (referer/bundle-id allowlist, usage cap):
# anything shipped in a client is readable by anyone who installs it.
# MAP_TILES_API_KEY=
